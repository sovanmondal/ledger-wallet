# Copy to .env for local overrides. NEVER commit a real .env.
PORT=8080

# Local docker-compose value (the app service reaches Postgres via the "db" host).
# For production, set this to your Neon connection string (sslmode=require).
DATABASE_URL=postgres://app:app@localhost:5432/wallet?sslmode=disable

LOG_LEVEL=info
RUN_MIGRATIONS=true

# CORS origin allowed to call the API (the Vercel UI origin in prod). "*" for local dev.
ALLOWED_ORIGIN=*
